# LLM settings for `rag-poc ask` and `rag-poc evaluate`.
# Copy this file to .env (gitignored), keep one preset active and add your key.
# Never commit a real key. Then confirm the setup with: uv run rag-poc llm-check
#
# Any API that speaks the OpenAI chat completions format works.

# --- OpenRouter (one key for many providers) ---------------------------------
RAG_LLM_BASE_URL=https://openrouter.ai/api/v1
RAG_LLM_MODEL_NAME=deepseek/deepseek-v4.1-flash-1017
RAG_LLM_API_KEY=your-api-key-here
# Reasoning is on by default for this model; turn it off for repeatable answers.
RAG_LLM_EXTRA_BODY='{"reasoning": {"effort": "none"}}'

# --- DeepSeek directly ---------------------------------------------------------
# RAG_LLM_BASE_URL=https://api.deepseek.com
# RAG_LLM_MODEL_NAME=deepseek-flash
# RAG_LLM_API_KEY=your-api-key-here
# RAG_LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'

# --- OpenAI --------------------------------------------------------------------
# RAG_LLM_BASE_URL=https://api.openai.com/v1
# RAG_LLM_MODEL_NAME=your-model-name
# RAG_LLM_API_KEY=your-api-key-here

# --- Local Ollama (no key; the model must be pulled and fit in free memory) ----
# RAG_LLM_BASE_URL=http://localhost:11434/v1
# RAG_LLM_MODEL_NAME=your-model-name

# --- Optional tuning (defaults shown) ------------------------------------------
# RAG_LLM_TEMPERATURE=0.2
# RAG_LLM_MAX_OUTPUT_TOKENS=1000
# RAG_LLM_TIMEOUT_SECONDS=120
# RAG_LLM_MAX_RETRIES=2
# RAG_ANSWER_TOP_K=10
# RAG_ANSWER_REVIEW_MAX_CHARS=800
# RAG_ANSWER_MIN_RELEVANCE=0.33
